    { "name": "Reviews - Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{base}}/api/reviews", "body": { "mode": "raw", "raw": "{\"productId\":1,\"note\":5,\"commentaire\":\"Top produit\"}" } } },
